# Copy this file to .env and replace every placeholder before production.
# Node 20.6+ can load .env directly via the npm scripts.

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://globalleaders.live

# Required in production: random, high-entropy value (32+ chars).
GL_ADMIN_SECRET=replace-with-a-long-random-secret

# Required in production: strong admin password (12+ chars).
GL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Required in production: random value used to hash abuse/fraud identifiers.
GL_FRAUD_SALT=replace-with-a-long-random-salt
