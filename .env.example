# Copy this file to .env and replace every placeholder before production.
# Never commit the real .env file.

PORT=3000
NODE_ENV=production
# Stripe yönlendirmeleri ve webhook'lar için HTTPS adresi şart.
PUBLIC_BASE_URL=https://globalleaders.live

# Admin security
GL_ADMIN_SECRET=replace-with-a-long-random-secret
GL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
GL_FRAUD_SALT=replace-with-a-long-random-salt

# İsteğe bağlı: SQLite dosyasının yeri (varsayılan var/globalleaders.db)
# GL_DB_FILE=/data/globalleaders.db

# ---------------------------------------------------------------------------
# 1) KRİPTO (soğuk cüzdan) — USDT/TRC20 transferi + zincir üstü doğrulama
# ---------------------------------------------------------------------------
# Yalnızca HERKESE AÇIK alım adresini yazın. Seed/private key ASLA buraya girmez.
CRYPTO_WALLET_ADDRESS=replace-with-your-public-cold-wallet-address
CRYPTO_ASSET=USDT
CRYPTO_NETWORK=TRC20

# İşlem hash'i girildiği an zincir kontrolü otomatik yapılsın mı?
# 1 = evet (önerilir; para geldiyse satın alma insan müdahalesi olmadan aktifleşir)
# 0 = hayır (admin panelinden "Zincirde kontrol et" ile elle tetiklenir)
AUTO_ONCHAIN_VERIFY=1

# Blokzincir API'si (TronGrid). TRON_API_KEY opsiyoneldir ama yüksek trafikte
# hız limiti için ücretsiz anahtar almanız önerilir: https://www.trongrid.io
TRONGRID_BASE=https://api.trongrid.io
TRON_API_KEY=
ONCHAIN_TIMEOUT_MS=9000

# ---------------------------------------------------------------------------
# 2) KART (Stripe Checkout) — Visa/Mastercard, tek tıkla güvenli sayfa
# ---------------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys adresinden alın.
# STRIPE_SECRET_KEY boşsa sitede kart seçeneği hiç görünmez (kripto çalışmaya devam eder).
STRIPE_SECRET_KEY=
# Webhook imzası. Stripe panelinde webhook uç noktası eklerken verilen "whsec_..." değeri:
#   POST https://globalleaders.live/api/webhooks/stripe
#   Olaylar: checkout.session.completed, checkout.session.expired,
#            payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=
# Test için: https://api.stripe.com (varsayılan). Sahte sunucu kullanmıyorsanız değiştirmeyin.
STRIPE_API_BASE=https://api.stripe.com

# ---------------------------------------------------------------------------
# 3) Sağlayıcı seçimi (genellikle değiştirmeniz gerekmez)
# ---------------------------------------------------------------------------
# cold_wallet = kripto ana yol, mock = yalnızca demo. Kart, istek içindeki
# "method":"card" alanıyla Stripe'a gider; ikisi aynı anda aktiftir.
PAYMENT_PROVIDER=cold_wallet

# E-posta (opsiyonel; şifre sıfırlama/doğrulama için)
RESEND_API_KEY=
