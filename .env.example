# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendinize göre düzenleyin.
# (sunucu bunları doğrudan okur; dotenv paketi gerekmez, Node 20.6+ .env destekler.
#  Daha eski Node sürümlerinde değerleri kabuk ortamında tanımlayın.)

# Sunucu portu (varsayılan: 3000)
PORT=3000

# Admin oturum çerezini imzalayan gizli anahtar — ÜRETİMDE MUTLAKA DEĞİŞTİRİN.
# Boş bırakılırsa her açılışta rastgele üretilir (oturumlar açılışta düşer).
GL_ADMIN_SECRET=degistir-beni-uzun-ve-rastgele-bir-anahtar
